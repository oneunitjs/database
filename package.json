{
  "name": "@oneunit/database",
  "version": "2.0.0-beta.1",
  "description": "Production-ready PostgreSQL client for Node.js with connection pooling, distributed transactions (2PC), schema auto-sync across shards, streaming cursors, query builder, table models, read-replica routing, and high-availability failover.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./column": {
      "types": "./dist/column/index.d.ts",
      "import": "./dist/column/index.js",
      "default": "./dist/column/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js",
      "default": "./dist/model/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js",
      "default": "./dist/query/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./json-serialization": {
      "types": "./dist/json-serialization.d.ts",
      "import": "./dist/json-serialization.js",
      "default": "./dist/json-serialization.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "pg",
    "database",
    "orm",
    "query-builder",
    "connection-pool",
    "transactions",
    "distributed-transactions",
    "two-phase-commit",
    "2pc",
    "sharding",
    "schema-sync",
    "schema-auto-sync",
    "read-replica",
    "failover",
    "high-availability",
    "streaming",
    "cursors",
    "migrations",
    "typescript",
    "nodejs"
  ],
  "author": {
    "name": "mayank",
    "url": "https://github.com/oneunitjs"
  },
  "contributors": [],
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oneunitjs/database.git",
    "directory": "packages/database"
  },
  "bugs": {
    "url": "https://github.com/oneunitjs/database/issues"
  },
  "homepage": "https://github.com/oneunitjs/database/tree/master/packages/database#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/oneunitjs"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "pg-query-stream": "^4.17.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "pg-cursor": "^2.21.0",
    "pg-query-stream": "^4.16.0"
  },
  "peerDependenciesMeta": {
    "pg-cursor": {
      "optional": true
    },
    "pg-query-stream": {
      "optional": true
    }
  }
}
